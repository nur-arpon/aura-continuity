<?xml version="1.0" encoding="utf-8"?>
<!-- No periodic updates: redrawn only when something changes (battery). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp" android:minHeight="110dp"
    android:minResizeWidth="220dp" android:minResizeHeight="110dp"
    android:targetCellWidth="4" android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/aura_away_widget"
    android:previewLayout="@layout/aura_away_widget"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/aura_away_widget_desc"/>
