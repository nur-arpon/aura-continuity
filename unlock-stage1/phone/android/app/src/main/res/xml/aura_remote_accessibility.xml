<?xml version="1.0" encoding="utf-8"?>
<!-- Watch control (FUTURE-PLANS item 7): no events at all (no accessibilityEventTypes), so this service hears nothing from any app.
     It exists only to perform taps / swipes / Back / Home / Recents and to type into the focused field when the owner's own
     paired watch asks. canRetrieveWindowContent is needed to find the focused text field. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/aura_remote_a11y_description"
    android:summary="@string/aura_remote_a11y_summary"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault"
    android:canRetrieveWindowContent="true"
    android:canPerformGestures="true"
    android:isAccessibilityTool="false"/>
