<?xml version="1.0" encoding="utf-8"?>
<!-- Aura home-screen widget (item 13): status line, "Continue from laptop" row, Lock / Unlock / Continue on PC. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="@drawable/aura_widget_bg">
    <!-- status line: Aura mark, PC name, state -->
    <LinearLayout android:id="@+id/aw_head" android:layout_width="match_parent" android:layout_height="22dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="4dp">
        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_aura_glyph"
            android:tint="@color/aura_w_brand" android:importantForAccessibility="no"/>
        <TextView android:id="@+id/aw_pc" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="6dp" android:text="Aura" android:textColor="@color/aura_w_text" android:textSize="13sp"
            android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end"/>
        <ImageView android:id="@+id/aw_dot" android:layout_width="7dp" android:layout_height="7dp" android:src="@drawable/aura_widget_dot"
            android:tint="@color/aura_w_success" android:importantForAccessibility="no"/>
        <TextView android:id="@+id/aw_state" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="5dp" android:text="Ready" android:textColor="@color/aura_w_text2" android:textSize="12sp" android:maxLines="1"/>
    </LinearLayout>
    <!-- Continue from laptop -->
    <LinearLayout android:id="@+id/aw_top" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="8dp" android:minHeight="52dp" android:background="@drawable/aura_widget_hero"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="10dp" android:paddingEnd="12dp">
        <FrameLayout android:id="@+id/aw_icon_bg" android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/aura_widget_icon_bg">
            <ImageView android:id="@+id/aw_icon" android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:src="@drawable/ic_aura_laptop"
                android:tint="#FFFFFFFF" android:importantForAccessibility="no"/>
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:layout_marginStart="10dp">
            <TextView android:id="@+id/aw_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Continue from laptop" android:textColor="@color/aura_w_text" android:textSize="14sp"
                android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/aw_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Tap to ask your PC" android:textColor="@color/aura_w_text2" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_aura_play"
            android:tint="@color/aura_w_primary" android:contentDescription="Continue"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal" android:layout_marginTop="8dp">
        <LinearLayout android:id="@+id/aw_lock" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:orientation="horizontal" android:gravity="center" android:background="@drawable/aura_widget_btn_primary"
            android:contentDescription="Lock">
            <ImageView android:id="@+id/aw_lock_icon" android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_aura_lock"
                android:tint="@color/aura_w_on_primary" android:importantForAccessibility="no"/>
            <TextView android:id="@+id/aw_lock_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
                android:text="Lock" android:textColor="@color/aura_w_on_primary" android:textSize="13sp" android:fontFamily="sans-serif-medium"
                android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/aw_unlock" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="6dp" android:orientation="horizontal" android:gravity="center" android:background="@drawable/aura_widget_btn"
            android:contentDescription="Unlock">
            <ImageView android:id="@+id/aw_unlock_icon" android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_aura_unlock"
                android:tint="@color/aura_w_btn_text" android:importantForAccessibility="no"/>
            <TextView android:id="@+id/aw_unlock_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
                android:text="Unlock" android:textColor="@color/aura_w_btn_text" android:textSize="13sp" android:fontFamily="sans-serif-medium"
                android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/aw_topc" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="6dp" android:orientation="horizontal" android:gravity="center" android:background="@drawable/aura_widget_btn"
            android:contentDescription="On PC">
            <ImageView android:id="@+id/aw_topc_icon" android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_aura_continue"
                android:tint="@color/aura_w_btn_text" android:importantForAccessibility="no"/>
            <TextView android:id="@+id/aw_topc_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
                android:text="On PC" android:textColor="@color/aura_w_btn_text" android:textSize="13sp" android:fontFamily="sans-serif-medium"
                android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
