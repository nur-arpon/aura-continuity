<?xml version="1.0" encoding="utf-8"?>
<!-- Zero-tap continue (item 19): the 2-second "Undo / Pick another" chip, drawn as an accessibility overlay. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal"
        android:gravity="center_vertical" android:background="@drawable/aura_zt_chip_bg" android:paddingStart="18dp" android:paddingEnd="8dp"
        android:elevation="8dp">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Continued from your PC"
                android:textColor="#FF9FB6DD" android:textSize="12sp"/>
            <TextView android:id="@+id/zt_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#FFEAF1FF" android:textSize="14sp" android:textStyle="bold" android:singleLine="true" android:ellipsize="end"/>
        </LinearLayout>
        <TextView android:id="@+id/zt_undo" android:layout_width="wrap_content" android:layout_height="36dp" android:gravity="center"
            android:paddingHorizontal="14dp" android:text="Undo" android:textColor="#FFEAF1FF" android:textStyle="bold"
            android:background="@drawable/aura_zt_btn_bg" android:layout_marginEnd="6dp"/>
        <TextView android:id="@+id/zt_pick" android:layout_width="wrap_content" android:layout_height="36dp" android:gravity="center"
            android:paddingHorizontal="14dp" android:text="Pick another" android:textColor="#FFEAF1FF" android:textStyle="bold"
            android:background="@drawable/aura_zt_btn_bg"/>
    </LinearLayout>
</FrameLayout>
