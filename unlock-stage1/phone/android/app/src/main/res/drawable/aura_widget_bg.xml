<?xml version="1.0" encoding="utf-8"?>
<!-- Aura widget card: soft vertical gradient + hairline, system widget radius on Android 12+ -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient android:angle="270" android:startColor="@color/aura_w_bg_top" android:endColor="@color/aura_w_bg_bottom"/>
    <stroke android:width="1dp" android:color="@color/aura_w_stroke"/>
    <corners android:radius="@dimen/aura_widget_radius"/>
</shape>
